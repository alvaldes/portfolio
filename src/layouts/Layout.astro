---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/navbar.astro";
import "../styles/global.css";
// import CommentForm from '../commentForm.js'

interface Props {
	title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

---

<!doctype html>
<html lang="es">
	<head>
		<!-- <meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title> -->
		<BaseHead lang="es" title={title} description='site.description' />
	</head>
	<body>
		<div class="pb-8">
			<Navbar path={currentPath} />
	  
			<div class="pt-14 container mx-auto w-4/5 md:w-7/12">
				<slot />
			</div>
			<div class="mx-auto text-center pt-1">
			  <!-- <CommentForm id="contact" /> -->
			  <span class="text-gray-800">
				&copy; {new Date().getFullYear()} Angel Valdés. {'copy-right'}
			  </span>
			</div>
		</div>
	</body>
</html>

<style>
	@import url('https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@300;400;500;700;800;900&display=swap');
	.link-font {
		font-family: 'M PLUS Rounded 1c', sans-serif;
	}
  </style>