---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/navbar.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import "../styles/global.css";
// import CommentForm from '../commentForm.js'

interface Props {
	title?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title = t("site.title") } = Astro.props;
const currentPath = Astro.url.pathname;

---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead lang={lang} title={title} description={t("site.description")} />
	</head>
	<body>
		<div class="pb-8">
			<Navbar path={currentPath} />
	  
			<div class="pt-14 container mx-auto w-4/5 md:w-7/12">
				<slot />
			</div>
			<div class="mx-auto text-center pt-1">
			  <!-- <CommentForm id="contact" /> -->
			  <span class="text-gray-800">
				&copy; {new Date().getFullYear()} Angel Valdés. {t("copy-right")}
			  </span>
			</div>
		</div>
	</body>
</html>

<style>
	@import url('https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@300;400;500;700;800;900&display=swap');
	.link-font {
		font-family: 'M PLUS Rounded 1c', sans-serif;
	}
  </style>