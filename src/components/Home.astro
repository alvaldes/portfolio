---
import { Image } from "astro:assets";
import Blob from "../assets/images/blob.svg";
import portrait from "../assets/images/angel.webp";
import EarthCanvas from "./islands/EarthCanvas";
import StarsCanvas from "./islands/StarsCanvas";
import { getDictionary, getLangFromUrl, getLocalizedPathname } from "../i18n/utils";
import InteractionHint from "./InteractionHint.astro";
import Section from "./Section.astro";
import Socials from "./Socials.astro";
import Timeline from "./Timeline.astro";

const lang = getLangFromUrl(Astro.url);
const { home } = getDictionary(lang);
---

<article class="mx-auto flex flex-col">
	<Section delay={0.2} id="banner" class="mt-3 flex flex-col gap-4">
		<div class="relative h-64 sm:h-72 lg:h-96">
			<!-- Islands: three.js only loads once the banner is on screen. -->
			<div class="relative h-full">
				<EarthCanvas client:visible />
				<InteractionHint />
			</div>
			<div class="absolute inset-0 -z-10 h-auto w-full">
				<StarsCanvas client:visible />
			</div>
		</div>

		<span class="rounded-md bg-black/5 px-11 py-3 text-center font-comfortaa font-black dark:bg-white/10">
			{home.banner}
		</span>

		<div class="grid-template mt-6 py-2">
			<div class="grid-info mt-8 flex flex-col items-start justify-start gap-1 self-start md:mt-12 lg:mt-14">
				<div class="mb-2 flex flex-wrap items-start gap-x-1.5 gap-y-1">
					<h1 class="text-2xl font-semibold md:text-3xl">{home.name}</h1>
					<span class="rounded-lg px-1.5 text-[8px] leading-3.5 font-bold bg-secondary text-primary-foreground shadow-md shadow-secondary/40 sm:text-[10px]">
						{home.experience}
					</span>
				</div>
				<h2 class="text-sm sm:text-lg">{home.description}</h2>
			</div>
			<div class="grid-socials flex items-center justify-center sm:mt-4 sm:items-start sm:justify-start">
				<Socials withEmail cvUrl={home.cv_url} />
			</div>
			<div class="grid-portrait flex shrink-0 justify-center">
				<!-- The blob box is 1.5x the photo so the shape shows the same margin at every size. -->
				<div class="relative mx-3 mt-4 size-28 sm:mx-0 sm:size-32 md:mt-9 md:size-40">
					<Blob aria-hidden="true" class="absolute -top-1/4 -left-1/4 size-[150%] text-primary" />
					<Image
						src={portrait}
						alt={home.name}
						widths={[112, 128, 160, 224, 256, 320]}
						sizes="(min-width: 768px) 160px, (min-width: 640px) 128px, 112px"
						loading="eager"
						class="relative size-full rounded-full border-2 border-primary"
					/>
				</div>
			</div>
		</div>
	</Section>

	<Section delay={0.3} id="bio" class="mt-8 flex flex-col gap-4 md:mt-0">
		<h1 class="text-2xl font-bold">{home.bio}</h1>
		<hr class="border-foreground/15" />
		<p>
			{home.resume}
			<a href={getLocalizedPathname(home.currentProject.url, lang)} class="font-medium text-secondary hover:underline">
				{home.currentProject.label}
			</a>.
		</p>
		<div class="flex justify-center">
			<a
				href={getLocalizedPathname("/works", lang)}
				class="group flex items-center gap-2 rounded-xl bg-primary px-8 py-3 text-lg font-bold text-primary-foreground hover:opacity-90"
			>
				{home.cta}
				<svg
					class="h-4 w-5 overflow-visible transition-[translate] duration-300 group-hover:translate-x-1 [&>path]:origin-center [&>path]:animate-flow-x [&>path]:[transform-box:fill-box]"
					viewBox="0 0 20 16"
					fill="currentColor"
					aria-hidden="true"
				>
					<!-- Three copies of one chevron, a third of the cycle apart, so they read as a conveyor. -->
					<path
						fill-rule="evenodd"
						clip-rule="evenodd"
						d="M4.53 4.345l3.25 3.25a.75.75 0 0 1 0 1.06l-3.25 3.25a.75.75 0 0 1-1.06-1.06l2.72-2.72-2.72-2.72a.75.75 0 0 1 1.06-1.06Z"
					></path>
					<path
						style="animation-delay: -667ms"
						fill-rule="evenodd"
						clip-rule="evenodd"
						d="M4.53 4.345l3.25 3.25a.75.75 0 0 1 0 1.06l-3.25 3.25a.75.75 0 0 1-1.06-1.06l2.72-2.72-2.72-2.72a.75.75 0 0 1 1.06-1.06Z"
					></path>
					<path
						style="animation-delay: -1333ms"
						fill-rule="evenodd"
						clip-rule="evenodd"
						d="M4.53 4.345l3.25 3.25a.75.75 0 0 1 0 1.06l-3.25 3.25a.75.75 0 0 1-1.06-1.06l2.72-2.72-2.72-2.72a.75.75 0 0 1 1.06-1.06Z"
					></path>
				</svg>
			</a>
		</div>
	</Section>

	<Section delay={0.4} id="timeline">
		<Timeline data={home.timeline} />
	</Section>
</article>
