---
import type { HTMLAttributes } from "astro/types";
import { getLangFromUrl, getLocalizedPathname, type UiType } from "../i18n/utils";

type Props = HTMLAttributes<"a"> & { language: UiType };

const { language, class: className, ...props } = Astro.props;
const { pathname } = Astro.url;

const isActive = language === getLangFromUrl(Astro.url);

const href = getLocalizedPathname(pathname, language);
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
    {language}
</a>
<style>
    a {
        display: inline-block;
        text-decoration: none;
    }
    a.active {
        font-weight: bolder;
        text-decoration: underline;
    }
</style>
