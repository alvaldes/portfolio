---
interface Props {
	data: string[];
}

const { data } = Astro.props;
---

<ul class="flex flex-wrap justify-start gap-y-1">
	{
		data.map((stack) => (
			<li class="ml-1 rounded-full border-2 border-secondary/40 bg-secondary/15 px-2 py-0.5 text-xs text-secondary-strong">
				{stack.trim()}
			</li>
		))
	}
</ul>
