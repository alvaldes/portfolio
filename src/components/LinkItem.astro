---
import { getLangFromUrl, getLocalizedPathname } from "../i18n/utils";

interface Props {
	label: string;
	// Path without locale prefix, e.g. "/" or "/works".
	href: string;
}

const { label, href } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const localizedHref = getLocalizedPathname(href, lang);
const isActive = getLocalizedPathname(Astro.url.pathname, lang) === localizedHref;
---

<a
	href={localizedHref}
	aria-current={isActive ? "page" : undefined}
	class:list={[
		"text-zinc-800 hover:underline dark:text-blue-50",
		// Same as portfolio-next: the link to the current page is not shown.
		{ hidden: isActive },
	]}
>
	{label}
</a>
