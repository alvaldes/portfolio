---
import { getLangFromUrl, getLocalizedPathname } from "../i18n/utils";

interface Props {
	noText?: boolean;
}

const { noText = false } = Astro.props;

const homeHref = getLocalizedPathname("/", getLangFromUrl(Astro.url));
const iconClass = "h-6 w-5 animate-flip-down group-hover:animate-flip-up";
---

<a href={homeHref} class="group flex w-fit items-center sm:mr-4">
	<img src="/images/logoSVG.svg" alt="logo" width="20" height="24" class:list={[iconClass, "dark:hidden"]} />
	<img src="/images/logoSVG-dark.svg" alt="logo" width="20" height="24" class:list={[iconClass, "hidden dark:block"]} />
	<span class:list={["ml-2 font-bold text-foreground", { "hidden sm:flex": noText }]}>
		Angel Valdés
	</span>
</a>
