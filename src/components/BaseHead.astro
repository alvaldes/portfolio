---
import { getRelativeLocaleUrl } from "astro:i18n";
import { LANGUAGES, getDictionary, getLocalizedPathname, type UiType } from "../i18n/utils";

interface Props {
	title: string;
	description: string;
	image?: string;
	type?: "website" | "article";
	lang: UiType;
}

// The default social card is 1200x630, one per language (public/og/).
const { lang, title, description, image = `/og/default-${lang}.jpg`, type = "website" } = Astro.props;

// Falls back to the request URL when `site` is not set in astro.config.mjs.
const siteURL = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, siteURL);
// The 404 renders at the URL that was not found: that URL has no canonical or translations.
const isNotFound = Astro.response.status === 404;
// Names the blog feed the same way src/lib/rss.ts titles it.
const feed = getDictionary(lang);

const alternateLinks = (Object.keys(LANGUAGES) as UiType[]).map((hreflang) => ({
	href: new URL(getLocalizedPathname(Astro.url.pathname, hreflang), siteURL),
	hreflang,
}));

// schema.org Person describing the site owner, for search engines.
// "<" is escaped so the JSON can never close the <script> element early.
const person = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "Person",
	name: feed.home.name,
	jobTitle: feed.site.jobTitle,
	description: feed.site.description,
	url: new URL(getRelativeLocaleUrl(lang), siteURL).href,
	sameAs: ["https://github.com/alvaldes", "https://www.linkedin.com/in/alvaldes/"],
}).replace(/</g, "\\u003c");
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Applies the saved or system theme before first paint to avoid a flash. -->
<!-- The preference (light, dark or system) is exposed on <html> so ThemeSwitcher can show it. -->
<script is:inline>
	(() => {
		let theme = null;
		try {
			theme = localStorage.getItem("theme");
		} catch {}
		const preference = theme === "light" || theme === "dark" ? theme : "system";
		const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
		document.documentElement.dataset.themePreference = preference;
		if (preference === "dark" || (preference === "system" && prefersDark)) {
			document.documentElement.classList.add("dark");
		}
	})();
</script>

<!-- Font preloads: body text weight, self-hosted (see global.css). -->
<link
	rel="preload"
	href="/fonts/m-plus-rounded-1c-latin-400.woff2"
	as="font"
	type="font/woff2"
	crossorigin
/>

{
	isNotFound ? (
		<meta name="robots" content="noindex" />
	) : (
		<>
			<!-- Canonical URL -->
			<link rel="canonical" href={canonicalURL} />

			<!-- Structured data -->
			<script type="application/ld+json" set:html={person} />

			<!-- Alternate URLs -->
			{alternateLinks.map(({ href, hreflang }) => (
				<link rel="alternate" href={href} hreflang={hreflang} />
			))}
		</>
	)
}

<!-- Blog feed in the page language (src/pages/rss.xml.ts and src/pages/en/rss.xml.ts). -->
<link rel="alternate" type="application/rss+xml" title={`${feed.site.title} · ${feed.blog.title}`} href={new URL(`${getRelativeLocaleUrl(lang)}rss.xml`, siteURL)} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:locale" content={lang} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />