---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import GithubIcon from "./icons/GithubIcon.astro";
import LangSwitcher from "./LangSwitcher.astro";
import LinkItem from "./LinkItem.astro";
import Logo from "./Logo.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";

const t = useTranslations(getLangFromUrl(Astro.url));

const SOURCE_URL = "https://github.com/alvaldes/portfolio";
const linkClass = "text-zinc-800 hover:underline dark:text-blue-50";
---

<nav class="fixed start-0 top-0 z-20 w-full bg-transparent backdrop-blur-md">
	<div class="mx-auto flex w-full flex-wrap items-center justify-between p-4 lg:max-w-[75%]">
		<Logo />

		<div class="flex gap-2 md:order-2">
			<ThemeSwitcher />
			<LangSwitcher />

			<details data-mobile-menu class="relative md:hidden">
				<summary
					aria-label={t("nav.menu")}
					class="flex size-8 cursor-pointer list-none items-center justify-center rounded-lg bg-foreground/10 p-1 text-foreground hover:bg-foreground/15 [&::-webkit-details-marker]:hidden"
				>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
					</svg>
				</summary>
				<div class="absolute end-0 mt-2 flex min-w-40 flex-col gap-3 rounded-xl border border-foreground/10 bg-background p-4 shadow-lg">
					<LinkItem label={t("nav.home")} href="/" />
					<LinkItem label={t("nav.works")} href="/works" />
					<a href="#contact-me" class={linkClass}>{t("nav.contact")}</a>
					<a href={SOURCE_URL} target="_blank" rel="noopener noreferrer" class:list={[linkClass, "flex items-center"]}>
						<GithubIcon class="size-4" />
						<span class="ml-1">{t("nav.source")}</span>
					</a>
				</div>
			</details>
		</div>

		<div class="hidden w-full items-center justify-between md:order-1 md:flex md:w-auto">
			<div class="flex gap-8 p-4 md:p-0">
				<LinkItem label={t("nav.home")} href="/" />
				<LinkItem label={t("nav.works")} href="/works" />
				<a href="#contact-me" class={linkClass}>{t("nav.contact")}</a>
				<a href={SOURCE_URL} target="_blank" rel="noopener noreferrer" class:list={[linkClass, "flex items-center"]}>
					<GithubIcon class="size-4" />
					<span class="ml-1">{t("nav.source")}</span>
				</a>
			</div>
		</div>
	</div>
</nav>

<script>
	// A <details> only closes from its own summary, so close the mobile menu
	// when a link is chosen, on a click outside it, or on Escape.
	for (const menu of document.querySelectorAll<HTMLDetailsElement>("[data-mobile-menu]")) {
		menu.addEventListener("click", (event) => {
			if ((event.target as Element).closest("a")) menu.open = false;
		});
		document.addEventListener("click", (event) => {
			if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
		});
		document.addEventListener("keydown", (event) => {
			if (event.key !== "Escape" || !menu.open) return;
			menu.open = false;
			menu.querySelector("summary")?.focus();
		});
	}
</script>
