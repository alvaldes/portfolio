---
import type { MarkdownHeading } from "astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const linkClass =
	"-ms-px block border-s-2 border-transparent py-1.5 ps-4 text-sm leading-snug text-foreground/60 transition-colors duration-200 hover:text-foreground data-active:border-primary data-active:text-primary";
---

<!-- Wide screens: a sticky index in the free space beside the article, so the text stays centered. -->
<aside class="absolute inset-y-0 start-full ms-12 hidden w-56 xl:block" aria-label={t("blog.toc")}>
	<nav class="sticky top-28">
		<p class="mb-3 text-xs font-medium tracking-wider text-secondary uppercase">{t("blog.toc")}</p>
		<ol class="border-s border-foreground/10">
			{
				headings.map((heading) => (
					<li>
						<a href={`#${heading.slug}`} class={linkClass} data-toc-link={heading.slug}>
							{heading.text}
						</a>
					</li>
				))
			}
		</ol>
	</nav>
</aside>

<!-- Narrow screens: the same index, collapsed above the article. -->
<details class="group mb-8 rounded-xl px-4 py-3 ring-1 ring-foreground/10 xl:hidden">
	<summary class="flex cursor-pointer list-none items-center justify-between text-xs font-medium tracking-wider text-secondary uppercase">
		{t("blog.toc")}
		<svg
			class="size-4 transition-transform duration-200 group-open:rotate-180"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<polyline points="6 9 12 15 18 9"></polyline>
		</svg>
	</summary>
	<ol class="mt-3 border-s border-foreground/10">
		{
			headings.map((heading) => (
				<li>
					<a href={`#${heading.slug}`} class={linkClass} data-toc-link={heading.slug}>
						{heading.text}
					</a>
				</li>
			))
		}
	</ol>
</details>

<script>
	// Marks the section being read: the last heading that has reached the top part of the screen.
	const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
	const ids = [...new Set(links.map((link) => link.dataset.tocLink!))];
	const headings = ids.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => el !== null);

	const update = () => {
		// The top 35% of the screen, and never less than the area under the fixed navbar.
		const threshold = Math.max(200, window.innerHeight * 0.35);
		let current: string | undefined;
		for (const heading of headings) {
			if (heading.getBoundingClientRect().top <= threshold) current = heading.id;
		}
		for (const link of links) {
			const active = link.dataset.tocLink === current;
			link.toggleAttribute("data-active", active);
			if (active) link.setAttribute("aria-current", "location");
			else link.removeAttribute("aria-current");
		}
	};

	let frame = 0;
	const schedule = () => {
		cancelAnimationFrame(frame);
		frame = requestAnimationFrame(update);
	};
	if (headings.length > 0) {
		window.addEventListener("scroll", schedule, { passive: true });
		window.addEventListener("resize", schedule);
		update();
	}

	// Picking a section on a small screen closes the dropdown, so the text is not covered.
	for (const details of document.querySelectorAll("details")) {
		if (!details.querySelector("[data-toc-link]")) continue;
		details.addEventListener("click", (event) => {
			if ((event.target as Element).closest("[data-toc-link]")) details.open = false;
		});
	}
</script>
