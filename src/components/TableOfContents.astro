---
import type { MarkdownHeading } from "astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import TableOfContentsList from "./TableOfContentsList.astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!--
	Wide screens: a sticky index in the free space beside the article, so the text stays centered.
	It needs 272px beside the 768px column (ms-12 + w-56) plus a gutter, so it starts at 1360px.
-->
<aside class="absolute inset-y-0 start-full ms-12 hidden w-56 min-[1360px]:block" aria-label={t("blog.toc")}>
	<!-- top-28 keeps the index clear of the fixed navbar. -->
	<nav class="sticky top-28">
		<p class="mb-3 text-xs font-medium tracking-wider text-secondary uppercase">{t("blog.toc")}</p>
		<TableOfContentsList headings={headings} />
	</nav>
</aside>

<!--
	Narrow screens: the same index, collapsed above the article.
	It hides at the same 1360px breakpoint where the aside appears; change both together.
-->
<details class="group mb-8 rounded-xl px-4 py-3 ring-1 ring-foreground/10 min-[1360px]:hidden" data-toc-dropdown>
	<summary class="flex cursor-pointer list-none items-center justify-between text-xs font-medium tracking-wider text-secondary uppercase">
		{t("blog.toc")}
		<svg
			class="size-4 transition-transform duration-200 group-open:rotate-180"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<polyline points="6 9 12 15 18 9"></polyline>
		</svg>
	</summary>
	<TableOfContentsList headings={headings} class="mt-3" />
</details>

<script>
	import { activeHeadingId } from "../lib/toc";

	const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
	// Both layouts render the same links, so each heading id appears twice.
	const ids = [...new Set(links.map((link) => link.dataset.tocLink!))];
	const headings = ids.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => el !== null);
	const navbar = document.querySelector("[data-site-navbar]");
	// Room below the navbar for a heading to count as reached once a link scrolls it into place.
	// Clicked headings stop at their scroll margin (scroll-mt-24 on .post-content headings in global.css);
	// keep this value above that margin minus the navbar height, or clicked headings will not turn active.
	const BELOW_NAVBAR = 80;

	const update = () => {
		// The top 35% of the screen, and never less than the area just under the fixed navbar.
		const navbarBottom = navbar?.getBoundingClientRect().bottom ?? 0;
		const threshold = Math.max(navbarBottom + BELOW_NAVBAR, window.innerHeight * 0.35);
		const current = activeHeadingId(
			headings.map((heading) => ({ id: heading.id, top: heading.getBoundingClientRect().top })),
			threshold,
		);
		for (const link of links) {
			const active = link.dataset.tocLink === current;
			link.toggleAttribute("data-active", active);
			if (active) link.setAttribute("aria-current", "location");
			else link.removeAttribute("aria-current");
		}
	};

	let frame = 0;
	const schedule = () => {
		cancelAnimationFrame(frame);
		frame = requestAnimationFrame(update);
	};
	if (headings.length > 0) {
		window.addEventListener("scroll", schedule, { passive: true });
		window.addEventListener("resize", schedule);
		update();
	}

	// Picking a section on a small screen closes the dropdown, so the text is not covered.
	for (const dropdown of document.querySelectorAll<HTMLDetailsElement>("[data-toc-dropdown]")) {
		dropdown.addEventListener("click", (event) => {
			if ((event.target as Element).closest("[data-toc-link]")) dropdown.open = false;
		});
	}
</script>
