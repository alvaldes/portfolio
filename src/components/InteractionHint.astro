---
// Mouse with blinking chevrons, hinting that the planet can be dragged.
const delays = [0.4, 0.6, 0.8];
const chevron = "size-1.5 border-t-2 border-foreground sm:size-2 hint-blink";
---

<div class="pointer-events-none absolute bottom-0 flex w-full items-center justify-end sm:right-10 sm:bottom-32 lg:bottom-40" aria-hidden="true">
	<ul class="relative mr-1 flex flex-row-reverse items-center justify-center">
		{delays.map((delay) => <li class:list={[chevron, "-rotate-45 border-l-2"]} style={`animation-delay: ${delay}s`} />)}
	</ul>
	<div class="flex h-[38px] w-[22px] items-start justify-center rounded-3xl border-2 border-foreground p-2 sm:h-[54px] sm:w-[30px] sm:border-3">
		<div class="mb-1 size-1.5 rounded-full bg-foreground sm:size-2"></div>
	</div>
	<ul class="relative ml-1 flex items-center justify-center">
		{delays.map((delay) => <li class:list={[chevron, "rotate-45 border-r-2"]} style={`animation-delay: ${delay}s`} />)}
	</ul>
</div>

<style>
	.hint-blink {
		opacity: 0;
		animation: hint-blink 2s ease-in-out infinite;
	}

	@keyframes hint-blink {
		50% {
			opacity: 1;
		}
	}
</style>
