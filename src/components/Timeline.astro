---
interface TimelineEntry {
	date: string;
	title: string;
	description: string;
	icon: string;
}

interface Props {
	data: TimelineEntry[];
}

const { data } = Astro.props;

// Heroicons 24/outline paths, as used in portfolio-next.
const ICON_PATHS: Record<string, string> = {
	rocketLaunch:
		"M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.631 8.41m5.96 5.96a14.926 14.926 0 0 1-5.841 2.58m-.119-8.54a6 6 0 0 0-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 0 0-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 0 1-2.448-2.448 14.9 14.9 0 0 1 .06-.312m-2.24 2.39a4.493 4.493 0 0 0-1.757 4.306 4.493 4.493 0 0 0 4.306-1.758M16.5 9a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z",
	briefcase:
		"M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z",
	buildingLibrary:
		"M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0 0 12 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75Z",
	academicCap:
		"M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5",
};
---

<section class="timeline-section">
	<div class="timeline-items">
		{
			data.map((entry) => (
				<div class="timeline-item">
					<span class="timeline-dot relative flex size-8">
						<span class="absolute inline-flex size-full animate-ping rounded-full bg-secondary opacity-75" />
						<span class="relative inline-flex size-8 rounded-full bg-secondary p-1">
							<svg class="text-white dark:text-primary-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d={ICON_PATHS[entry.icon]} />
							</svg>
						</span>
					</span>
					<div class="timeline-date text-secondary">{entry.date}</div>
					<div class="timeline-content bg-white/40 dark:bg-white/5">
						<h3 class="text-secondary-strong dark:text-foreground">{entry.title}</h3>
						<p class="text-zinc-500 dark:text-zinc-400">{entry.description}</p>
					</div>
				</div>
			))
		}
	</div>
</section>

<style>
	/* Ported from portfolio-next ResponsiveTimeline.module.css. */
	.timeline-section {
		min-height: 100vh;
		padding: 100px 15px;
	}

	.timeline-items {
		max-width: 1000px;
		margin: auto;
		display: flex;
		flex-wrap: wrap;
		position: relative;
	}

	.timeline-items::before {
		content: "";
		position: absolute;
		width: 2px;
		height: 100%;
		background-image: linear-gradient(var(--color-secondary) 50%, transparent 50%);
		background-size: 100% 10px;
		left: calc(50% - 1px);
	}

	.timeline-item {
		margin-bottom: 40px;
		width: 100%;
		position: relative;
	}

	.timeline-item:last-child {
		margin-bottom: 0;
	}

	.timeline-item:nth-child(odd) {
		padding-right: calc(50% + 30px);
		text-align: right;
	}

	.timeline-item:nth-child(even) {
		padding-left: calc(50% + 30px);
	}

	.timeline-dot {
		position: absolute;
		left: calc(50% - 16px);
		border-radius: 50%;
		top: 10px;
	}

	.timeline-date {
		font-size: 18px;
		margin: 12px 0 15px;
	}

	.timeline-content {
		padding: 30px;
		border-radius: 10px;
	}

	.timeline-content h3 {
		font-size: 20px;
		margin: 0 0 10px;
		font-weight: 500;
	}

	.timeline-content p {
		font-size: 16px;
		font-weight: 300;
		line-height: 22px;
	}

	/* Scroll-driven grow-in; replaces framer-motion's useScroll in portfolio-next. */
	@supports (animation-timeline: view()) {
		.timeline-item {
			animation: grow-in linear both;
		}

		/* Separate rule on purpose: the CSS minifier would otherwise fold
		   animation-timeline into the `animation` shorthand, which is invalid. */
		.timeline-items > .timeline-item {
			animation-timeline: view();
			animation-range: entry 0% cover 40%;
		}

		@keyframes grow-in {
			from {
				opacity: 0.6;
				scale: 0.8;
			}
			to {
				opacity: 1;
				scale: 1;
			}
		}
	}

	@media (max-width: 767px) {
		.timeline-items::before {
			left: 14px;
		}

		.timeline-item:nth-child(odd) {
			padding-right: 0;
			text-align: left;
		}

		.timeline-item:nth-child(odd),
		.timeline-item:nth-child(even) {
			padding-left: 37px;
		}

		.timeline-dot {
			left: 0;
		}
	}
</style>
