---
import OutlineIcon from "./icons/OutlineIcon.astro";

interface Props {
	href: string;
	class?: string;
	disabled?: boolean;
}

const { href, class: className, disabled = false } = Astro.props;
---

{
	disabled ? (
		<span class:list={["text-secondary opacity-50", className]}>
			<slot />
		</span>
	) : (
		<a
			href={href}
			target="_blank"
			rel="noopener noreferrer"
			class:list={["inline-flex items-center gap-1 break-all text-secondary hover:underline", className]}
		>
			<slot />
			<OutlineIcon name="arrowTopRightOnSquare" class="size-4 shrink-0" />
		</a>
	)
}
