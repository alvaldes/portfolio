---
import { OUTLINE_ICONS, type OutlineIconName } from "./paths";

interface Props {
	name: OutlineIconName;
	class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
	{OUTLINE_ICONS[name].map((d) => <path stroke-linecap="round" stroke-linejoin="round" d={d} />)}
</svg>
